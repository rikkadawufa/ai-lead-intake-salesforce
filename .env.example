# Copy this file to .env and fill values locally. Do not commit .env.
# Salesforce: My Domain URL (https://<name>.my.salesforce.com) and the External Client App's Consumer Key/Secret.
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SLACK_WEBHOOK_URL=
# Login for the review page and its form (basic auth). Pick a long random password; reviewers share it.
REVIEW_USER=
REVIEW_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_MODE=
# off: sort leads but never draft replies (no review page, no review link in Slack).
DRAFT_MODE=
# Demo only: approved replies go to this inbox instead of the made-up customer address.
DEMO_MODE=
REPLY_REDIRECT_TO=
GENERIC_TIMEZONE=
N8N_VERSION=
N8N_ENCRYPTION_KEY=
